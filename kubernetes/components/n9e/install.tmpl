#!/bin/bash
# Install Nightingale (n9e) via Helm
# Rendered by blcli; namespace and values can be parameterized.
set -euo pipefail

if ! command -v helm &> /dev/null; then
  echo "Error: helm is not installed or not in PATH"
  echo "Install from: https://helm.sh/docs/intro/install/"
  exit 1
fi

if ! command -v kubectl &> /dev/null; then
  echo "Error: kubectl is not installed or not in PATH"
  echo "Install from: https://kubernetes.io/docs/tasks/tools/"
  exit 1
fi

MIN_HELM_VERSION="{{ if .minHelmVersion }}{{ .minHelmVersion }}{{ end }}"
if [ -n "${MIN_HELM_VERSION}" ]; then
  ACTUAL=$(helm version --short 2>/dev/null | tr -d 'v' | sed 's/+.*//' || true)
  if [ -z "${ACTUAL}" ]; then
    echo "Error: could not get helm version (helm version --short)"
    exit 1
  fi
  MIN_NORM=$(echo "${MIN_HELM_VERSION}" | tr -d 'v')
  if [ "$(printf '%s\n' "${MIN_NORM}" "${ACTUAL}" | sort -V | head -n1)" != "${MIN_NORM}" ]; then
    echo "Error: helm version ${ACTUAL} is older than required ${MIN_HELM_VERSION}"
    exit 1
  fi
  echo "helm version ${ACTUAL} meets requirement >= ${MIN_HELM_VERSION}"
fi

MIN_KUBECTL_VERSION="{{ if .minKubectlVersion }}{{ .minKubectlVersion }}{{ end }}"
if [ -n "${MIN_KUBECTL_VERSION}" ]; then
  ACTUAL=$(kubectl version --client --short 2>/dev/null | sed 's/Client Version: v//' | tr -d ' ' || true)
  if [ -z "${ACTUAL}" ]; then
    ACTUAL=$(kubectl version --client -o json 2>/dev/null | sed -n 's/.*"gitVersion":"v\?\([^"]*\)".*/\1/p' || true)
  fi
  if [ -z "${ACTUAL}" ]; then
    echo "Error: could not get kubectl version"
    exit 1
  fi
  MIN_NORM=$(echo "${MIN_KUBECTL_VERSION}" | tr -d 'v')
  if [ "$(printf '%s\n' "${MIN_NORM}" "${ACTUAL}" | sort -V | head -n1)" != "${MIN_NORM}" ]; then
    echo "Error: kubectl version ${ACTUAL} is older than required ${MIN_KUBECTL_VERSION}"
    exit 1
  fi
  echo "kubectl version ${ACTUAL} meets requirement >= ${MIN_KUBECTL_VERSION}"
fi

NAMESPACE="{{ .namespace }}"
RELEASE_NAME="{{ .releaseName }}"
VALUES_FILES="{{ if .valuesFiles }}{{ .valuesFiles }}{{ else }}values.yaml values-override.yaml{{ end }}"

if [ ! -f "Chart.yaml" ]; then
  echo "Error: Chart.yaml not found. Run this script from the component directory."
  exit 1
fi

HELM_VALUES=()
for f in ${VALUES_FILES}; do
  if [ ! -f "${f}" ]; then
    echo "Error: required values file missing: ${f}"
    exit 1
  fi
  HELM_VALUES+=(-f "${f}")
done

echo "Installing Nightingale (n9e): release=${RELEASE_NAME}, namespace=${NAMESPACE}"
# Security generation 2 is the one-time migration boundary (chart, not app version).
# Exact JSON matching avoids release-name regex/substring errors. Fail closed on
# malformed output, unknown charts, or an unreadable Helm release list.
if ! command -v python3 >/dev/null; then
  echo "Error: python3 is required to inspect the deployed chart version."
  exit 1
fi
# Filter server-side too: Helm list otherwise truncates large namespaces.
RELEASE_FILTER=$(python3 -c 'import re, sys; print("^" + re.escape(sys.argv[1]) + "$")' "${RELEASE_NAME}")
RELEASES=$(helm list -n "${NAMESPACE}" --all --filter "${RELEASE_FILTER}" -o json)
MIGRATION_STATE=$(printf '%s' "${RELEASES}" | python3 -c '
import json, re, sys
rows = json.load(sys.stdin)
if not isinstance(rows, list):
    sys.exit("Error: Helm release list must be an array")
if any(not isinstance(row, dict) for row in rows):
    sys.exit("Error: malformed Helm release row")
matches = [row for row in rows if row.get("name") == sys.argv[1]]
if not matches:
    print("absent")
else:
    if len(matches) != 1:
        sys.exit("Error: ambiguous Helm release metadata")
    match = re.fullmatch(re.escape(sys.argv[2]) + r"-(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)", matches[0].get("chart", ""))
    if not match:
        sys.exit("Error: unrecognized deployed chart version; inspect migration manually")
    print("legacy" if int(match.group(1)) < 2 else "current")
' "${RELEASE_NAME}" "n9e")
if [ "${MIGRATION_STATE}" = legacy ] && [ "${BLCLI_SECURITY_MIGRATION_APPROVED:-}" != "1" ]; then
  echo "Error: review SECURITY.md, back up data and complete migration; then set BLCLI_SECURITY_MIGRATION_APPROVED=1 for this upgrade."
  exit 1
fi
helm dependency build --skip-refresh
kubectl create namespace "${NAMESPACE}" --dry-run=client -o yaml | kubectl apply -f -
helm upgrade --install "${RELEASE_NAME}" . -n "${NAMESPACE}" "${HELM_VALUES[@]}" --wait --timeout "${HELM_TIMEOUT:-15m}"

echo "Nightingale (n9e) installed successfully."
