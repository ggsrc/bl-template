# Per-environment overrides, rendered by blcli.
# Use together with values.yaml: helm upgrade -i -f values.yaml -f values-override.yaml
redis:
  image:
    registry: docker.io
    repository: bitnami/redis
  auth:
    existingSecret: {{ default `redis-shared` .existingSecret }}
    existingSecretPasswordKey: {{ default `REDIS_PASSWORD` .existingSecretPasswordKey }}
  # Commands renamed to "" (disabled). The chart default is FLUSHDB and FLUSHALL only.
  # CONFIG, DEBUG, MODULE and SLAVEOF/REPLICAOF let any client that knows the
  # password reconfigure the server, write files or load native code.
  # Sentinel mode needs CONFIG and REPLICAOF; remove them if you enable Sentinel.
  master:
    disableCommands:
      - FLUSHDB
      - FLUSHALL
      - CONFIG
      - DEBUG
      - MODULE
      - SLAVEOF
      - REPLICAOF
{{- if not (or .allowLuaScripting .AllowLuaScripting) }}
      # Lua scripting and functions (CVE-2025-49844 and other Lua engine bugs).
      # Set allowLuaScripting: true to keep them for clients that need Lua.
      - EVAL
      - EVALSHA
      - EVAL_RO
      - EVALSHA_RO
      - FUNCTION
      - FCALL
      - FCALL_RO
      - SCRIPT
{{- end }}
  replica:
    disableCommands:
      - FLUSHDB
      - FLUSHALL
      - CONFIG
      - DEBUG
      - MODULE
      - SLAVEOF
      - REPLICAOF
{{- if not (or .allowLuaScripting .AllowLuaScripting) }}
      # Lua scripting and functions (CVE-2025-49844 and other Lua engine bugs).
      # Set allowLuaScripting: true to keep them for clients that need Lua.
      - EVAL
      - EVALSHA
      - EVAL_RO
      - EVALSHA_RO
      - FUNCTION
      - FCALL
      - FCALL_RO
      - SCRIPT
{{- end }}
  sentinel:
    resources:
      requests:
        cpu: {{ default `150m` .cpuRequest }}
        memory: {{ default `100M` .memoryRequest }}
      limits:
        cpu: {{ default `1000m` .cpuLimit }}
        memory: {{ default `500M` .memoryLimit }}
{{- if .enableInternalLB }}
  extraDeploy:
    - apiVersion: v1
      kind: Service
      metadata:
        name: {{ default `redis-shared-lb` .internalLBServiceName }}
        namespace: {{ default `redis` .namespace }}
        annotations:
          cloud.google.com/load-balancer-type: "Internal"
      spec:
        type: LoadBalancer
        ports:
          - name: redis
            port: 6379
            protocol: TCP
            targetPort: 6379
        selector:
          app.kubernetes.io/name: redis
          app.kubernetes.io/component: master
{{- end }}
