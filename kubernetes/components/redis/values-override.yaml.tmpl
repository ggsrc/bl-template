# Per-environment overrides, rendered by blcli.
# Use together with values.yaml: helm upgrade -i -f values.yaml -f values-override.yaml
valkey:
  # Keep the in-cluster address of the previous Bitnami chart: <release>-master.<namespace>.svc
  fullnameOverride: {{ default `redis` .releaseName }}-master
  # The chart default is auth.enabled: false; authentication must stay on.
  auth:
    enabled: true
    usersExistingSecret: {{ default `redis-shared` .existingSecret }}
    aclUsers:
      # Application user. @dangerous covers CONFIG, DEBUG, MODULE, REPLICAOF/SLAVEOF, FLUSHALL,
      # FLUSHDB, KEYS, MONITOR, SHUTDOWN, CLIENT LIST/KILL and similar; INFO is added back for
      # client libraries. @scripting (EVAL, FUNCTION, SCRIPT, ...) is removed unless allowLuaScripting.
      default:
        passwordKey: {{ default `REDIS_PASSWORD` .existingSecretPasswordKey }}
        permissions: "~* &* +@all -@dangerous +info{{ if not (or .allowLuaScripting .AllowLuaScripting) }} -@scripting{{ end }}{{ if .extraAclRules }} {{ .extraAclRules }}{{ end }}"
      # Read-only user for the metrics exporter sidecar (same password Secret key).
      metrics:
        passwordKey: {{ default `REDIS_PASSWORD` .existingSecretPasswordKey }}
        permissions: "-@all +ping +info +select +client|setname +client|list +slowlog|get +slowlog|len +latency|latest +latency|histogram +commandlog|get +commandlog|len +memory|stats"
  resources:
    requests:
      cpu: {{ default `150m` .cpuRequest }}
      memory: {{ default `100M` .memoryRequest }}
    limits:
      cpu: {{ default `1000m` .cpuLimit }}
      memory: {{ default `500M` .memoryLimit }}

internalLB:
  enabled: {{ if .enableInternalLB }}true{{ else }}false{{ end }}
  name: {{ default `redis-shared-lb` .internalLBServiceName }}
  sourceRanges: "{{ .internalLBSourceRanges }}"
