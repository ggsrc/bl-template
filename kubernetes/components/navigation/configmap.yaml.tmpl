apiVersion: v1
kind: ConfigMap
metadata:
  name: homer-config
  namespace: {{ default "navigation" .namespace }}
data:
  config.yml: |
    title: "{{ default `Infra Navigation` .title }}"
    subtitle: "{{ default `Internal links` .subtitle }}"
    logo: "logo.png"
    header: true
    footer: false
    columns: "3"
    defaults:
      layout: list
    services:
      - name: "Grafana"
        icon: "fas fa-chart-line"
        url: "{{ default `https://grafana.example.com` .grafanaURL }}"
        target: "_blank"
      - name: "Argo CD"
        icon: "fas fa-ship"
        url: "{{ default `https://argocd.example.com` .argocdURL }}"
        target: "_blank"
