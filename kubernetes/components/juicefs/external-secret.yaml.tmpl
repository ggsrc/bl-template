{{- /* Lookups list the CamelCase key first (set from kebab-case args such as meta-url-secret-name), so it wins over the args.yaml default of the camelCase key. */ -}}
# juicefs-secret is synced from GCP Secret Manager; no credential is rendered into this repo.
# Create these Secret Manager secrets (names can be changed with the *SecretName arguments):
#   juicefs-metaurl             metadata engine URL, for example
#                               postgres://USER:PASSWORD@HOST:5432/juicefs?sslmode=require
#   juicefs-gateway-access-key  S3 gateway access key (also passed to "juicefs format" as the object storage access key)
#   juicefs-gateway-secret-key  S3 gateway secret key (also passed to "juicefs format" as the object storage secret key)
# Until they exist the ExternalSecret reports an error and the gateway pods do not start.
apiVersion: external-secrets.io/v1
kind: ExternalSecret
metadata:
  name: juicefs-secret
  namespace: {{ default "juicefs" .namespace }}
spec:
  refreshInterval: 1h
  secretStoreRef:
    kind: ClusterSecretStore
    name: {{ or .SecretStoreName .secretStoreName "gcp-secret-store" }}
  target:
    name: juicefs-secret
    creationPolicy: Owner
  data:
    - secretKey: metaurl
      remoteRef:
        key: {{ or .MetaURLSecretName .metaURLSecretName "juicefs-metaurl" }}
    - secretKey: gateway-access-key
      remoteRef:
        key: {{ or .GatewayAccessKeySecretName .gatewayAccessKeySecretName "juicefs-gateway-access-key" }}
    - secretKey: gateway-secret-key
      remoteRef:
        key: {{ or .GatewaySecretKeySecretName .gatewaySecretKeySecretName "juicefs-gateway-secret-key" }}
