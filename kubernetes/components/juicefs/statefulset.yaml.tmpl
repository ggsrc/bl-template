apiVersion: apps/v1
kind: StatefulSet
metadata:
  name: juicefs-s3-gateway
  namespace: {{ default "juicefs" .namespace }}
  labels:
    app.kubernetes.io/name: juicefs-s3-gateway
spec:
  serviceName: juicefs-s3-gateway
  replicas: {{ default 1 .replicas }}
  selector:
    matchLabels:
      app.kubernetes.io/name: juicefs-s3-gateway
  template:
    metadata:
      labels:
        app.kubernetes.io/name: juicefs-s3-gateway
    spec:
      serviceAccountName: juicefs-s3-gateway
      containers:
        - name: gateway
          image: {{ default `juicedata/mount` .gatewayImageRepository }}:{{ default `ce-v1.3.1` .gatewayImageTag }}
          imagePullPolicy: IfNotPresent
          command:
            - sh
            - -c
            - juicefs gateway ${METAURL} 0.0.0.0:9000 --metrics=0.0.0.0:9567
          env:
            - name: METAURL
              valueFrom:
                secretKeyRef:
                  name: juicefs-secret
                  key: metaurl
            - name: MINIO_ROOT_USER
              valueFrom:
                secretKeyRef:
                  name: juicefs-secret
                  key: gateway-access-key
            - name: MINIO_ROOT_PASSWORD
              valueFrom:
                secretKeyRef:
                  name: juicefs-secret
                  key: gateway-secret-key
          ports:
            - containerPort: 9000
              name: http
            - containerPort: 9567
              name: metrics
