# Sync via External Secrets Operator; example structure only.
apiVersion: v1
kind: Secret
metadata:
  name: juicefs-secret
  namespace: {{ default "juicefs" .namespace }}
type: Opaque
stringData:
  metaurl: {{ default `postgres://user:pass@host:5432/juicefs?sslmode=disable` .metaURL }}
  gateway-access-key: {{ default `minioadmin` .gatewayAccessKey }}
  gateway-secret-key: {{ default `minioadmin` .gatewaySecretKey }}
