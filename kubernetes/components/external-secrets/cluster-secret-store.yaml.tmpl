apiVersion: v1
kind: ServiceAccount
metadata:
  name: gcp-secret-manager
  namespace: external-secrets
  annotations:
    iam.gke.io/gcp-service-account: {{ .SecretManagerServiceAccountEmail | default .secretManagerServiceAccountEmail | default "" }}
---
apiVersion: external-secrets.io/v1
kind: ClusterSecretStore
metadata:
  name: gcp-secret-store
  namespace: external-secrets
spec:
  # Only these namespaces may reference this store. Without conditions, any
  # namespace could read every secret the store's service account can access.
  # Conditions are ORed: a namespace matches if it carries the label below
  # or is listed by name in AllowedNamespaces.
  conditions:
    - namespaceSelector:
        matchLabels:
          gcp-secret-store-access: "allowed"
{{- if .AllowedNamespaces }}
    - namespaces:
{{- range .AllowedNamespaces }}
        - {{ . }}
{{- end }}
{{- end }}
  provider:
    gcpsm:
      projectID: {{ .project_id | default .ProjectID | default "" }}
      auth:
        workloadIdentity:
          clusterLocation: {{ if .ClusterLocation }}{{ .ClusterLocation }}{{ else }}us-west1{{ end }}
          clusterName: {{ if .ClusterName }}{{ .ClusterName }}{{ else }}app{{ end }}
          serviceAccountRef:
            name: gcp-secret-manager
            namespace: external-secrets
