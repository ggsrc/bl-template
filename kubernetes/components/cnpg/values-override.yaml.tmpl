# Per-environment overrides, rendered by blcli.
# Use together with values.yaml: helm upgrade -i -f values.yaml -f values-override.yaml
cloudnative-pg:
  replicaCount: {{ default 1 .replicaCount }}
  image:
    repository: ghcr.io/cloudnative-pg/cloudnative-pg
    pullPolicy: IfNotPresent
    tag: "{{ default `1.29.1` .imageTag }}"
  resources:
    limits:
      cpu: "{{ default `1` .cpuLimit }}"
      memory: "{{ default `2Gi` .memoryLimit }}"
    requests:
      cpu: "{{ default `100m` .cpuRequest }}"
      memory: "{{ default `200Mi` .memoryRequest }}"
