# Environment overrides, rendered by blcli.
# Use together with values.yaml: helm upgrade -i -f values.yaml -f values-corp.yaml
#
# authMode:
#   google   (default) - Google sign-in only, limited to hostedDomain. Needs the grafana-google-auth
#                        secret (GOOGLE_AUTH_CLIENT_ID / GOOGLE_AUTH_CLIENT_SECRET) in GCP Secret Manager.
#   password           - Grafana's own login form with the built-in admin user. The chart generates a
#                        random admin password once and keeps it across upgrades:
#                        kubectl -n <namespace> get secret <release> -o jsonpath='{.data.admin-password}' | base64 -d
googleAuth:
  enabled: {{ if eq (default "google" .authMode) "password" }}false{{ else }}true{{ end }}
grafana:
  image:
    registry: docker.io
    repository: grafana/grafana
    tag: "{{ default `12.4.13` .imageTag }}"
    pullPolicy: IfNotPresent

  rbac:
    create: true
    namespaced: false
  serviceAccount:
    create: true

  replicas: {{ default 1 .replicas }}

  headlessService: false
  automountServiceAccountToken: true

  podDisruptionBudget:
   minAvailable: 1

  deploymentStrategy:
    type: RollingUpdate

  testFramework:
    enabled: true
    imagePullPolicy: IfNotPresent
    securityContext: {}
    containerSecurityContext: {}
    resources:
     limits:
       cpu: 1
       memory: 1Gi
     requests:
       cpu: 100m
       memory: 256Mi

  createConfigmap: true

  service:
    enabled: true
    type: ClusterIP
    port: 80
    targetPort: 3000

  serviceMonitor:
    enabled: true
    path: /metrics
    interval: 30s
    scheme: http
    scrapeTimeout: 30s
    relabelings: []
    metricRelabelings: []

  persistence:
    type: pvc
    enabled: true
    accessModes:
      - ReadWriteOnce
    size: {{ default `10Gi` .persistenceSize }}
    finalizers:
      - kubernetes.io/pvc-protection
    lookupVolumeName: true

  initChownData:
    enabled: true

  # Pinned as <id>@<version>; unpinned plugins are fetched at their latest version on every pod start.
  plugins:
    - victoriametrics-metrics-datasource@0.26.1
    - redis-app@2.3.2
    - redis-datasource@2.2.0
    - redis-explorer-app@2.1.1
    - grafana-googlesheets-datasource@2.7.2
    - grafana-github-datasource@2.9.4
    - grafana-clickhouse-datasource@4.23.0
    - yesoreyeram-infinity-datasource@4.1.3

  datasources:
    datasources.yaml:
      apiVersion: 1
      datasources:
      - name: victoria-metrics
        type: prometheus
        url: {{ default `http://vmselect-victoriametrics-vmks.monitoring-vm.svc.cluster.local:8481/select/0/prometheus` .vmDatasourceUrl }}
        access: proxy
        jsonData:
          httpMethod: POST
          manageAlerts: true
          timeInterval: 15s
          queryTimeout: 90s
          prometheusType: Prometheus
          cacheLevel: "High"
          disableRecordingRules: false
          incrementalQueryOverlapWindow: 10m
      - name: victoria-metrics-native
        type: victoriametrics-metrics-datasource
        url: {{ default `http://vmselect-victoriametrics-vmks.monitoring-vm.svc.cluster.local:8481/select/0/prometheus` .vmDatasourceUrl }}
        access: proxy
        isDefault: true
        jsonData:
          httpMethod: POST
          manageAlerts: true
          timeInterval: 15s
          queryTimeout: 90s
          disableMetricsLookup: false
{{- if ne (printf "%v" .lokiEnabled) "false" }}
      - name: loki-logs
        type: loki
        access: proxy
        url: {{ default `http://loki-gateway.loki.svc.cluster.local` .lokiDatasourceUrl }}
        jsonData:
          timeout: 30
          maxLines: 1000
          httpHeaderName1: X-Scope-OrgID
        secureJsonData:
          httpHeaderValue1: fake
{{- end }}

{{- if ne (default "google" .authMode) "password" }}
  envFromSecrets:
  - name: grafana-google-auth
    optional: false
{{- end }}

  grafana.ini:
    paths:
      data: /var/lib/grafana/
      logs: /var/log/grafana
      plugins: /var/lib/grafana/plugins
      provisioning: /etc/grafana/provisioning
    analytics:
      check_for_updates: true
    log:
      mode: console
    server:
      root_url: {{ default `https://example.com/grafana` .rootUrl }}
    security:
      # Session cookies are only sent over HTTPS. Set cookieSecure: false only while Grafana is reached
      # over plain HTTP (e.g. kubectl port-forward); turn it back on once it is served over HTTPS.
      cookie_secure: {{ if eq (printf "%v" .cookieSecure) "false" }}false{{ else }}true{{ end }}
{{- if eq (default "google" .authMode) "password" }}
    auth:
      disable_login_form: false
    auth.basic:
      enabled: false
    auth.anonymous:
      enabled: false
    users:
      allow_sign_up: false
{{- else }}
    auth:
      disable_login_form: true
    auth.basic:
      enabled: false
    auth.google:
      enabled: true
      allow_sign_up: true
      auto_login: false
      client_id: "$__env{GOOGLE_AUTH_CLIENT_ID}"
      client_secret: "$__env{GOOGLE_AUTH_CLIENT_SECRET}"
      scopes: openid email profile https://www.googleapis.com/auth/cloud-identity.groups.readonly
      auth_url: https://accounts.google.com/o/oauth2/v2/auth
      token_url: https://oauth2.googleapis.com/token
      api_url: https://openidconnect.googleapis.com/v1/userinfo
      # hosted_domain is only a hint to Google's account chooser; allowed_domains is what Grafana enforces
      # (the e-mail domain of every new login). Accounts outside it are refused.
      hosted_domain: {{ if .hostedDomain }}{{ .hostedDomain }}{{ else if .HostedDomain }}{{ .HostedDomain }}{{ else }}example.com{{ end }}
      allowed_domains: {{ if .hostedDomain }}{{ .hostedDomain }}{{ else if .HostedDomain }}{{ .HostedDomain }}{{ else }}example.com{{ end }}
      {{- if .allowedGroups }}
      allowed_groups: {{ .allowedGroups | quote }}
      {{- else if .AllowedGroups }}
      allowed_groups: {{ .AllowedGroups | quote }}
      {{- end }}
      use_pkce: true
{{- end }}
    feature_toggles:
      provisioning: true
      kubernetesDashboards: true

  sidecar:
    resources:
      limits:
        cpu: 100m
        memory: 100Mi
      requests:
        cpu: 50m
        memory: 50Mi

  networkPolicy:
    enabled: false

  useStatefulSet: false

  assertNoLeakedSecrets: true
