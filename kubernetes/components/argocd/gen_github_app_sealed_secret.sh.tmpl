#!/bin/bash

set -euo pipefail

# Seals the ArgoCD GitHub App credentials (GitAuthMethod: github-app) into one credential
# template Secret (label argocd.argoproj.io/secret-type=repo-creds). ArgoCD uses it for every
# repository whose https URL starts with GitHubAppCredsURL, so one Secret covers all the
# repositories the App installation can read. The App needs read-only "Contents" (and
# "Metadata") permission on those repositories, nothing else.
# Usage: ./gen_github_app_sealed_secret.sh [<path_to_github_app_private_key.pem>]
#        default key: <keys dir>/{{ if .GitHubAppPrivateKeyFile }}{{ .GitHubAppPrivateKeyFile }}{{ else }}argocd_github_app.pem{{ end }} (keys dir: ARGOCD_KEYS_DIR, default ../../../keys)
# The plaintext Secret is never written to disk: it is piped from kubectl straight into kubeseal.

NAMESPACE="{{ if .Namespace }}{{ .Namespace }}{{ else }}argocd{{ end }}"
OUTPUT_FILE="github-app-sealed-secret.yaml"
SECRET_NAME="{{ if .GitHubAppSecretName }}{{ .GitHubAppSecretName }}{{ else }}argocd-github-app-creds{{ end }}"
CREDS_URL="{{ if .GitHubAppCredsURL }}{{ .GitHubAppCredsURL }}{{ else }}https://github.com/example-org{{ end }}"
APP_ID="{{ if .GitHubAppID }}{{ .GitHubAppID }}{{ end }}"
INSTALLATION_ID="{{ if .GitHubAppInstallationID }}{{ .GitHubAppInstallationID }}{{ end }}"
ENTERPRISE_BASE_URL="{{ if .GitHubAppEnterpriseBaseURL }}{{ .GitHubAppEnterpriseBaseURL }}{{ end }}"
KEYS_DIR="${ARGOCD_KEYS_DIR:-../../../keys}"
KEY_PATH="${1:-${KEYS_DIR}/{{ if .GitHubAppPrivateKeyFile }}{{ .GitHubAppPrivateKeyFile }}{{ else }}argocd_github_app.pem{{ end }}}"

if [ -z "${APP_ID}" ] || [ -z "${INSTALLATION_ID}" ]; then
    echo "Error: set GitHubAppID and GitHubAppInstallationID in the args file and re-render."
    exit 1
fi
case "${CREDS_URL}" in
    https://*) ;;
    *) echo "Error: GitHubAppCredsURL must be an https URL (GitHub App credentials do not work with SSH): ${CREDS_URL}"; exit 1 ;;
esac
if [ ! -f "${KEY_PATH}" ]; then
    echo "Error: GitHub App private key not found: ${KEY_PATH}"
    echo "Download it from the App settings (Private keys > Generate) and store it outside the repository."
    exit 1
fi

if ! command -v kubeseal &> /dev/null; then
    echo "Error: kubeseal is not installed. Please install kubeseal first."
    echo "  macOS: brew install kubeseal"
    echo "  Linux: download from https://github.com/bitnami-labs/sealed-secrets/releases"
    exit 1
fi
if ! kubectl cluster-info &> /dev/null; then
    echo "Error: cannot connect to the Kubernetes cluster. Make sure kubectl is configured correctly."
    exit 1
fi
echo "Current Kubernetes context: $(kubectl config current-context)"
echo "Warning: make sure you are connected to the right cluster"
echo ""

enterprise_args=()
if [ -n "${ENTERPRISE_BASE_URL}" ]; then
    enterprise_args=(--from-literal=githubAppEnterpriseBaseUrl="${ENTERPRISE_BASE_URL}")
fi
SEALED=$(kubectl create secret generic "${SECRET_NAME}" -n "${NAMESPACE}" \
    --from-literal=type=git \
    --from-literal=url="${CREDS_URL}" \
    --from-literal=githubAppID="${APP_ID}" \
    --from-literal=githubAppInstallationID="${INSTALLATION_ID}" \
    ${enterprise_args[@]+"${enterprise_args[@]}"} \
    --from-file=githubAppPrivateKey="${KEY_PATH}" --dry-run=client -o yaml \
    | kubectl label --local -f - argocd.argoproj.io/secret-type=repo-creds -o yaml \
    | kubeseal --format yaml)
printf '%s\n' "${SEALED}" > "${OUTPUT_FILE}"

echo "GitHub App credentials sealed: ${OUTPUT_FILE} (Secret ${NAMESPACE}/${SECRET_NAME}, repositories under ${CREDS_URL})"
echo "Commit ${OUTPUT_FILE}; never commit the private key."
