#!/bin/bash

# ArgoCD installation script
# This script installs ArgoCD using kustomize
set -e

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

# Configuration
NAMESPACE="${ARGOCD_NAMESPACE:-{{ if .Namespace }}{{ .Namespace }}{{ else }}argocd{{ end }}}"
{{- $version := "v3.5.6" }}{{ if .ArgoCDVersion }}{{ $version = .ArgoCDVersion }}{{ end }}
ARGOCD_VERSION="{{ $version }}"
ARGOCD_MANIFEST_URL="{{ if .ArgoCDManifestURL }}{{ .ArgoCDManifestURL }}{{ else }}https://raw.githubusercontent.com/argoproj/argo-cd/{{ $version }}/manifests/install.yaml{{ end }}"
# sha256 of manifests/install.yaml for v3.5.6; any other version or URL needs ArgoCDManifestSHA256.
ARGOCD_MANIFEST_SHA256="{{ if .ArgoCDManifestSHA256 }}{{ .ArgoCDManifestSHA256 }}{{ else if and (not .ArgoCDManifestURL) (eq $version "v3.5.6") }}846c644bc81ce5557dd9048757a9c7353378f25c5eb811c77d32a9e907823599{{ end }}"
ARGOCD_MANIFEST_FILE="argocd-install.yaml"
APPPROJECT_FILE="appproject.yaml"
UI_URL="{{ if eq .ServerInsecure false }}https://localhost:8080{{ else }}http://localhost:8080{{ end }}{{ if .ServerRootPath }}{{ .ServerRootPath }}{{ else }}/argocd{{ end }}"
UI_PORT="{{ if eq .ServerInsecure false }}443{{ else }}80{{ end }}"
ADMIN_ENABLED="{{ if .AdminEnabled }}true{{ else }}false{{ end }}"
{{- $dexOrgsMissing := false }}
{{- if .DexConfig }}{{ range .DexConfig.connectors }}{{ if and (eq .type "github") (not .config.orgs) }}{{ $dexOrgsMissing = true }}{{ end }}{{ end }}
{{- else if .DexGitHubEnabled }}{{ if not .DexGitHubOrgs }}{{ $dexOrgsMissing = true }}{{ end }}{{ end }}
DEX_GITHUB_ORGS_MISSING="{{ $dexOrgsMissing }}"
{{- $ssoConfigured := false }}
{{- if .DexConfig }}{{ if .DexConfig.connectors }}{{ $ssoConfigured = true }}{{ end }}{{ else if .DexGitHubEnabled }}{{ $ssoConfigured = true }}{{ end }}
SSO_CONFIGURED="{{ $ssoConfigured }}"
{{- $allReposHaveKeys := false }}
{{- if .GitRepositories }}{{ $allReposHaveKeys = true }}{{ range .GitRepositories }}{{ if not .sshPrivateKeyFile }}{{ $allReposHaveKeys = false }}{{ end }}{{ end }}{{ end }}
ALL_REPOS_HAVE_KEYS="{{ $allReposHaveKeys }}"
{{- $mode := "github-app" }}{{ if .GitAuthMethod }}{{ $mode = .GitAuthMethod }}{{ end }}
GIT_AUTH_METHOD="{{ $mode }}"
GITHUB_APP_IDS_SET="{{ if and .GitHubAppID .GitHubAppInstallationID }}true{{ else }}false{{ end }}"
# Every repository URL ArgoCD is given; checked against GIT_AUTH_METHOD below.
REPO_URLS=(
{{- if .GitRepositories }}{{ range .GitRepositories }}
    "{{ .url }}"
{{- end }}{{ else if .GitRepositoryURL }}
    "{{ .GitRepositoryURL }}"
{{- end }}
{{- range .AppProjectSourceRepos }}
    "{{ . }}"
{{- end }}
)
GITHUB_APP_SECRET_FILE="github-app-sealed-secret.yaml"
GEN_GITHUB_APP_SCRIPT="${ARGOCD_GEN_GITHUB_APP_SCRIPT:-gen_github_app_sealed_secret.sh}"
GITHUB_APP_KEY_PATH="${ARGOCD_GITHUB_APP_PRIVATE_KEY_PATH:-}"
SSH_SECRET_FILE="github-ssh-sealed-secret.yaml"
GEN_SSH_SCRIPT="${ARGOCD_GEN_SEALED_SECRET_SCRIPT:-gen_ssh_sealed_secrets.sh}"
DEX_SECRET_FILE="dex-github-sealed-secret.yaml"
GEN_DEX_SCRIPT="${ARGOCD_GEN_DEX_SECRET_SCRIPT:-gen_dex_sealed_secret.sh}"
KUBERNETES_INIT_SCRIPT="${ARGOCD_KUBERNETES_INIT_SCRIPT:-../../init.sh}"
# The deploy key lives outside the kubernetes repository: <workspace>/keys by default
# (this directory is <workspace>/kubernetes/<project>/argocd). Earlier versions used
# <workspace>/kubernetes/keys; that location is still read if it holds a key.
if [ -n "${ARGOCD_KEYS_DIR:-}" ]; then
    SSH_KEYS_DIR="${ARGOCD_KEYS_DIR}"
elif [ -n "${BLCLI_KEYS_DIR:-}" ]; then
    SSH_KEYS_DIR="${BLCLI_KEYS_DIR}"
elif [ ! -f "../../../keys/argocd_github" ] && [ -f "../../keys/argocd_github" ]; then
    SSH_KEYS_DIR="../../keys"
else
    SSH_KEYS_DIR="../../../keys"
fi
SSH_PRIVATE_KEY_PATH="${ARGOCD_SSH_PRIVATE_KEY_PATH:-${SSH_KEYS_DIR}/argocd_github}"
GITHUB_APP_KEY_PATH="${GITHUB_APP_KEY_PATH:-${SSH_KEYS_DIR}/{{ if .GitHubAppPrivateKeyFile }}{{ .GitHubAppPrivateKeyFile }}{{ else }}argocd_github_app.pem{{ end }}}"

# Function to print colored messages
info() {
    echo -e "${GREEN}[INFO]${NC} $1"
}

warn() {
    echo -e "${YELLOW}[WARN]${NC} $1"
}

error() {
    echo -e "${RED}[ERROR]${NC} $1"
}

# Check if kubectl is available
if ! command -v kubectl &> /dev/null; then
    error "kubectl is not installed or not in PATH"
    exit 1
fi

if ! command -v curl &> /dev/null; then
    error "curl is not installed or not in PATH"
    exit 1
fi

# Check if kustomize is available
if ! command -v kustomize &> /dev/null; then
    error "kustomize is not installed or not in PATH"
    error "Install kustomize: https://kubectl.docs.kubernetes.io/installation/kustomize/"
    exit 1
fi

# Without orgs the GitHub connector lets every GitHub account log in.
if [ "${DEX_GITHUB_ORGS_MISSING}" = "true" ]; then
    error "The Dex GitHub connector has no orgs: any GitHub account could log in to ArgoCD."
    error "Set config.orgs on the connector in DexConfig (or DexGitHubOrgs), re-render and run this script again."
    exit 1
fi

# With the local admin disabled, SSO is the only way to log in.
if [ "${ADMIN_ENABLED}" != "true" ] && [ "${SSO_CONFIGURED}" != "true" ]; then
    error "AdminEnabled is false and no Dex connector is configured (DexConfig.connectors or DexGitHubEnabled):"
    error "nobody could log in to ArgoCD. Configure SSO, or set AdminEnabled: true, re-render and run this script again."
    exit 1
fi

# Repository credentials are matched by URL: GitHub App credentials only apply to https URLs,
# an SSH key only to SSH URLs. A URL of the other kind would silently get no credentials.
case "${GIT_AUTH_METHOD}" in
    github-app|ssh) ;;
    *) error "GitAuthMethod must be github-app or ssh, not '${GIT_AUTH_METHOD}'"; exit 1 ;;
esac
for url in ${REPO_URLS[@]+"${REPO_URLS[@]}"}; do
    if [ "${GIT_AUTH_METHOD}" = "github-app" ] && [[ "${url}" != https://* ]]; then
        error "GitAuthMethod is github-app but ${url} is not an https URL; GitHub App credentials only work over https."
        exit 1
    fi
    if [ "${GIT_AUTH_METHOD}" = "ssh" ] && [[ "${url}" == https://* ]]; then
        error "GitAuthMethod is ssh but ${url} is an https URL; the SSH deploy key only works with git@ or ssh:// URLs."
        exit 1
    fi
done
if [ "${GIT_AUTH_METHOD}" = "github-app" ] && [ "${GITHUB_APP_IDS_SET}" != "true" ]; then
    error "GitAuthMethod is github-app: set GitHubAppID and GitHubAppInstallationID, re-render and run this script again."
    exit 1
fi

sha256_of() {
    if command -v sha256sum &> /dev/null; then
        sha256sum "$1" | awk '{print $1}'
    else
        shasum -a 256 "$1" | awk '{print $1}'
    fi
}

# Check kubectl connection
if ! kubectl cluster-info &> /dev/null; then
    error "Cannot connect to Kubernetes cluster. Please check kubectl configuration."
    exit 1
fi

CURRENT_CONTEXT=$(kubectl config current-context)
info "Current Kubernetes context: ${CURRENT_CONTEXT}"
warn "Please ensure you are connected to the correct cluster"

# kubeseal fetches the Sealed Secrets controller's certificate. On a fresh cluster the sealed-secret
# component is applied moments earlier and the controller may not be serving yet ("no endpoints
# available for service sealed-secrets-controller"), so wait for its rollout first.
SEALED_SECRETS_NAMESPACE="${SEALED_SECRETS_CONTROLLER_NAMESPACE:-kube-system}"
if kubectl -n "${SEALED_SECRETS_NAMESPACE}" get deployment sealed-secrets-controller &> /dev/null; then
    info "Waiting for the Sealed Secrets controller in ${SEALED_SECRETS_NAMESPACE}"
    kubectl -n "${SEALED_SECRETS_NAMESPACE}" rollout status deployment/sealed-secrets-controller --timeout=300s
fi

if [ "${GIT_AUTH_METHOD}" = "github-app" ]; then
    # GitHub App: one credential template Secret for every https repository under GitHubAppCredsURL.
    if [ -f "${GEN_GITHUB_APP_SCRIPT}" ] && [ -f "${GITHUB_APP_KEY_PATH}" ]; then
        info "Sealing the GitHub App credentials via ${GEN_GITHUB_APP_SCRIPT}"
        ARGOCD_KEYS_DIR="${SSH_KEYS_DIR}" bash "./${GEN_GITHUB_APP_SCRIPT}" "${GITHUB_APP_KEY_PATH}"
    fi
    if [ ! -f "${GITHUB_APP_SECRET_FILE}" ]; then
        warn "GitHub App sealed secret (${GITHUB_APP_SECRET_FILE}) not found and no private key at ${GITHUB_APP_KEY_PATH}"
        info "Seal it with: ./${GEN_GITHUB_APP_SCRIPT} <path_to_github_app_private_key.pem>"
        if [ -t 0 ]; then
            read -p "Do you want to continue without repository credentials? (y/N): " -n 1 -r
            echo
            if [[ ! $REPLY =~ ^[Yy]$ ]]; then
                info "Installation cancelled"
                exit 0
            fi
        else
            warn "Non-interactive mode: continuing without repository credentials"
        fi
        info "Creating placeholder ${GITHUB_APP_SECRET_FILE} for kustomize build (replace with the real sealed secret later)"
        cat > "${GITHUB_APP_SECRET_FILE}" << 'PLACEHOLDER'
# Placeholder - replace with output of ./gen_github_app_sealed_secret.sh <path_to_github_app_private_key.pem>
apiVersion: v1
kind: Secret
metadata:
  name: github-app-placeholder
  namespace: argocd
type: Opaque
PLACEHOLDER
    fi
else
    if [ "${SSH_KEYS_DIR}" = "../../keys" ]; then
        warn "Using the deploy key in ${SSH_KEYS_DIR}, which is inside the kubernetes repository."
        warn "Move it to ../../../keys (or set BLCLI_KEYS_DIR). If it was ever committed, rotate the deploy key."
    fi

    # Ensure SSH key material exists before generating sealed secret
    if [ ! -f "${SSH_PRIVATE_KEY_PATH}" ] && [ -f "${KUBERNETES_INIT_SCRIPT}" ]; then
        if [ ! -x "${KUBERNETES_INIT_SCRIPT}" ]; then
            chmod +x "${KUBERNETES_INIT_SCRIPT}"
        fi
        info "Generating ArgoCD SSH keys via ${KUBERNETES_INIT_SCRIPT}"
        BLCLI_KEYS_DIR="${SSH_KEYS_DIR}" "./${KUBERNETES_INIT_SCRIPT}"
    fi

    # Generate SSH sealed secret before kustomize build
    if [ -f "${GEN_SSH_SCRIPT}" ]; then
        if [ ! -x "${GEN_SSH_SCRIPT}" ]; then
            chmod +x "${GEN_SSH_SCRIPT}"
        fi
        # Seals every configured repository with its own key (GitRepositories[].sshPrivateKeyFile)
        # or, for entries without one, the default key.
        if [ -f "${SSH_PRIVATE_KEY_PATH}" ]; then
            info "Generating SSH sealed secret via ${GEN_SSH_SCRIPT}"
            ARGOCD_KEYS_DIR="${SSH_KEYS_DIR}" "./${GEN_SSH_SCRIPT}" "${SSH_PRIVATE_KEY_PATH}"
        elif [ "${ALL_REPOS_HAVE_KEYS}" = "true" ]; then
            info "Generating SSH sealed secret via ${GEN_SSH_SCRIPT} (per-repository keys in ${SSH_KEYS_DIR})"
            ARGOCD_KEYS_DIR="${SSH_KEYS_DIR}" "./${GEN_SSH_SCRIPT}"
        fi
    fi

    # Check if SSH sealed secret exists
    if [ ! -f "${SSH_SECRET_FILE}" ]; then
        warn "GitHub SSH sealed secret file (${SSH_SECRET_FILE}) not found"
        if [ -f "${GEN_SSH_SCRIPT}" ]; then
            warn "SSH private key not found at ${SSH_PRIVATE_KEY_PATH}"
            info "To generate the SSH sealed secret manually, run:"
            info "  ./${GEN_SSH_SCRIPT} <path_to_ssh_private_key>"
            if [ -t 0 ]; then
                read -p "Do you want to continue without SSH secret? (y/N): " -n 1 -r
                echo
                if [[ ! $REPLY =~ ^[Yy]$ ]]; then
                    info "Installation cancelled"
                    exit 0
                fi
            else
                warn "Non-interactive mode: continuing without SSH secret"
            fi
        else
            warn "Continuing without SSH secret file"
        fi
    else
        info "Found SSH sealed secret file: ${SSH_SECRET_FILE}"
    fi

    # Ensure kustomize can run: create placeholder if resource is missing
    if [ ! -f "${SSH_SECRET_FILE}" ]; then
        info "Creating placeholder ${SSH_SECRET_FILE} for kustomize build (replace with real sealed secret later)"
        cat > "${SSH_SECRET_FILE}" << 'PLACEHOLDER'
# Placeholder - replace with output of ./gen_ssh_sealed_secrets.sh <path_to_ssh_private_key>
apiVersion: v1
kind: Secret
metadata:
  name: github-ssh-placeholder
  namespace: argocd
type: Opaque
PLACEHOLDER
    fi
fi

# Dex GitHub client secret: argocd-cm only references it, the value comes from a sealed Secret.
# Set DEX_GITHUB_CLIENT_SECRET for non-interactive runs.
dex_secret_missing() {
    [ ! -f "${DEX_SECRET_FILE}" ] || grep -qF "dex-github-placeholder" "${DEX_SECRET_FILE}"
}
if grep -qF -- "${DEX_SECRET_FILE}" kustomization.yaml 2>/dev/null && dex_secret_missing; then
    if [ -f "${GEN_DEX_SCRIPT}" ] && [ -n "${DEX_GITHUB_CLIENT_SECRET:-}" ]; then
        info "Sealing the Dex GitHub client secret via ${GEN_DEX_SCRIPT}"
        bash "./${GEN_DEX_SCRIPT}"
    elif [ -f "${GEN_DEX_SCRIPT}" ] && [ -t 0 ]; then
        read -p "Seal the Dex GitHub client secret now? (Y/n): " -n 1 -r
        echo
        if [[ ! $REPLY =~ ^[Nn]$ ]]; then
            bash "./${GEN_DEX_SCRIPT}"
        fi
    fi
    if dex_secret_missing; then
        warn "Dex client secret not sealed: GitHub SSO will not work until you run ./${GEN_DEX_SCRIPT} and re-run this script"
        info "Creating placeholder ${DEX_SECRET_FILE} for kustomize build"
        cat > "${DEX_SECRET_FILE}" << 'PLACEHOLDER'
# Placeholder - replace with output of ./gen_dex_sealed_secret.sh
apiVersion: v1
kind: Secret
metadata:
  name: dex-github-placeholder
  namespace: argocd
type: Opaque
PLACEHOLDER
    fi
fi

# The pinned ArgoCD manifest, verified by sha256. It is kept next to kustomization.yaml (commit
# it with the rest of this directory): `kubectl delete -k`, which `blcli destroy kubernetes`
# runs, `kustomize build` and `kubectl diff -k` all need it. A copy that does not match the pin
# is replaced by a fresh download; a download that does not match is refused.
if [ -z "${ARGOCD_MANIFEST_SHA256}" ]; then
    error "No sha256 is pinned for ${ARGOCD_MANIFEST_URL}."
    if curl -fsSL --retry 3 -o "${ARGOCD_MANIFEST_FILE}.download" "${ARGOCD_MANIFEST_URL}"; then
        error "Downloaded digest: $(sha256_of "${ARGOCD_MANIFEST_FILE}.download"). Verify it against the release, set ArgoCDManifestSHA256 and re-render."
        rm -f "${ARGOCD_MANIFEST_FILE}.download"
    fi
    exit 1
fi
if [ -f "${ARGOCD_MANIFEST_FILE}" ] && [ "$(sha256_of "${ARGOCD_MANIFEST_FILE}")" = "${ARGOCD_MANIFEST_SHA256}" ]; then
    info "Using verified ArgoCD ${ARGOCD_VERSION} manifest: ${ARGOCD_MANIFEST_FILE}"
else
    info "Downloading ArgoCD ${ARGOCD_VERSION} manifest: ${ARGOCD_MANIFEST_URL}"
    trap 'rm -f "${ARGOCD_MANIFEST_FILE}.download"' EXIT
    if ! curl -fsSL --retry 3 -o "${ARGOCD_MANIFEST_FILE}.download" "${ARGOCD_MANIFEST_URL}"; then
        error "Failed to download ${ARGOCD_MANIFEST_URL}"
        exit 1
    fi
    ACTUAL_SHA256=$(sha256_of "${ARGOCD_MANIFEST_FILE}.download")
    if [ "${ACTUAL_SHA256}" != "${ARGOCD_MANIFEST_SHA256}" ]; then
        error "sha256 mismatch for ${ARGOCD_MANIFEST_URL}: expected ${ARGOCD_MANIFEST_SHA256}, got ${ACTUAL_SHA256}"
        exit 1
    fi
    mv "${ARGOCD_MANIFEST_FILE}.download" "${ARGOCD_MANIFEST_FILE}"
    info "Verified and saved ${ARGOCD_MANIFEST_FILE}; commit it so kubectl delete -k and kustomize build keep working"
fi

# Build kustomization (kept in memory, no temporary file)
info "Building kustomization..."
if ! MANIFESTS=$(kustomize build .); then
    error "Failed to build kustomization"
    exit 1
fi

# Apply manifests. Server-side apply: the ArgoCD CRDs are too large for the
# last-applied annotation of a client-side apply.
info "Applying ArgoCD manifests..."
if ! printf '%s\n' "${MANIFESTS}" | kubectl apply --server-side --force-conflicts -f -; then
    error "Failed to apply ArgoCD manifests"
    exit 1
fi

# 3.x ignores argocd-cm.data.repositories, but apply does not remove a key it no longer renders.
# Drop the leftover 2.x repository list so the live ConfigMap matches this configuration.
if kubectl -n "${NAMESPACE}" get configmap argocd-cm -o jsonpath='{.data.repositories}' 2>/dev/null | grep -q .; then
    info "Removing the obsolete repositories key from argocd-cm (repositories now come from Secrets)"
    kubectl -n "${NAMESPACE}" patch configmap argocd-cm --type=json -p='[{"op":"remove","path":"/data/repositories"}]'
fi

# AppProjects need the AppProject CRD, which the manifests above install.
if [ -f "${APPPROJECT_FILE}" ]; then
    info "Applying AppProjects..."
    kubectl wait --for=condition=established --timeout=60s crd/appprojects.argoproj.io
    if ! kubectl apply --server-side --force-conflicts -f "${APPPROJECT_FILE}"; then
        error "Failed to apply ${APPPROJECT_FILE}"
        exit 1
    fi
fi

# Wait for ArgoCD to be ready
info "Waiting for ArgoCD to be ready..."
if kubectl wait --for=condition=available --timeout=300s deployment/argocd-server -n "${NAMESPACE}" 2>/dev/null; then
    info "ArgoCD server is ready"
else
    warn "ArgoCD server may still be starting. Check status with:"
    warn "  kubectl get pods -n ${NAMESPACE}"
fi

# Get ArgoCD server info
info "ArgoCD installation completed!"
echo ""
info "To access ArgoCD UI:"
info "  1. Port forward: kubectl port-forward svc/argocd-server -n ${NAMESPACE} 8080:${UI_PORT}"
if [ "${ADMIN_ENABLED}" = "true" ]; then
    info "  2. Get admin password: kubectl -n ${NAMESPACE} get secret argocd-initial-admin-secret -o jsonpath=\"{.data.password}\" | base64 -d"
    info "  3. Login: ${UI_URL} (username: admin)"
else
    info "  2. Login: ${UI_URL} with SSO (the local admin account is disabled; set AdminEnabled for break-glass access)"
    if kubectl -n "${NAMESPACE}" get secret argocd-initial-admin-secret &> /dev/null; then
        warn "argocd-initial-admin-secret still exists; delete it: kubectl -n ${NAMESPACE} delete secret argocd-initial-admin-secret"
    fi
fi
echo ""
info "To check ArgoCD status:"
info "  kubectl get pods -n ${NAMESPACE}"
info "  kubectl get svc -n ${NAMESPACE}"
