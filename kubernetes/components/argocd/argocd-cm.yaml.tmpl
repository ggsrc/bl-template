apiVersion: v1
kind: ConfigMap
metadata:
  name: argocd-cm
  labels:
    app.kubernetes.io/name: argocd-cm
    app.kubernetes.io/part-of: argocd
data:
  # Repositories are not configured here: ArgoCD 3.x only reads them from Secrets labelled
  # argocd.argoproj.io/secret-type=repository or repo-creds (sealed by gen_github_app_sealed_secret.sh
  # or gen_ssh_sealed_secrets.sh, depending on GitAuthMethod).

  # The local admin account is off; users sign in through Dex SSO.
  admin.enabled: "{{ if .AdminEnabled }}true{{ else }}false{{ end }}"

  {{- if .ArgoCDURL }}
  url: {{ .ArgoCDURL }}
  {{- end }}

  {{- /* The client secret is a $<secret>:<key> reference, resolved by ArgoCD from a Secret labelled app.kubernetes.io/part-of=argocd (see gen_dex_sealed_secret.sh). Without orgs any GitHub account can log in: the install script refuses to apply that. */}}
  {{- if .DexConfig }}
  dex.config: |
    connectors:
      {{- range .DexConfig.connectors }}
      - type: {{ .type }}
        id: {{ .id }}
        name: {{ .name }}
        config:
          {{- if eq .type "github" }}
          clientID: {{ .config.clientID }}
          clientSecret: {{ if .config.clientSecretRef }}{{ .config.clientSecretRef }}{{ else }}${{ if $.DexClientSecretName }}{{ $.DexClientSecretName }}{{ else }}argocd-dex-github{{ end }}:{{ if $.DexClientSecretKey }}{{ $.DexClientSecretKey }}{{ else }}clientSecret{{ end }}{{ end }}
          {{- if .config.orgs }}
          orgs:
            {{- range .config.orgs }}
            - name: {{ .name }}
            {{- end }}
          {{- end }}
          {{- end }}
      {{- end }}
  {{- else if .DexGitHubEnabled }}
  dex.config: |
    connectors:
      - type: github
        id: github
        name: GitHub
        config:
          clientID: {{ .DexGitHubClientID }}
          clientSecret: ${{ if .DexClientSecretName }}{{ .DexClientSecretName }}{{ else }}argocd-dex-github{{ end }}:{{ if .DexClientSecretKey }}{{ .DexClientSecretKey }}{{ else }}clientSecret{{ end }}
          {{- if .DexGitHubOrgs }}
          orgs:
            {{- range .DexGitHubOrgs }}
            - name: {{ . }}
            {{- end }}
          {{- end }}
  {{- end }}
