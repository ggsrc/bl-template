#!/bin/bash

set -euo pipefail

# Seals the ArgoCD repository Secrets (repository URL + SSH deploy key) into one file.
# Usage: ./gen_ssh_sealed_secrets.sh [<path_to_default_ssh_private_key>]
#
# ArgoCD 3.x reads repositories only from Secrets labelled argocd.argoproj.io/secret-type=repository
# that hold url, type and sshPrivateKey; the `repositories` key of argocd-cm is no longer read.
# A GitHub deploy key belongs to one repository, so with several repositories give each
# GitRepositories entry its own key (sshPrivateKeyFile, relative to the keys directory
# ARGOCD_KEYS_DIR, default: the directory of the default key). Entries without one use the
# default key, which then has to be a key that can read all of them (for example a machine user's).
# The plaintext Secret is never written to disk: it is piped from kubectl straight into kubeseal.

DEFAULT_KEY_PATH="${1:-}"
NAMESPACE="{{ if .Namespace }}{{ .Namespace }}{{ else }}argocd{{ end }}"
OUTPUT_FILE="github-ssh-sealed-secret.yaml"
if [ -n "${ARGOCD_KEYS_DIR:-}" ]; then
    KEYS_DIR="${ARGOCD_KEYS_DIR}"
elif [ -n "${DEFAULT_KEY_PATH}" ]; then
    KEYS_DIR="$(dirname "${DEFAULT_KEY_PATH}")"
else
    KEYS_DIR="../../../keys"
fi

# <secret name>|<url>|<type>|<display name>|<key file, empty = default key>
REPOSITORIES=(
{{- $defaultSecret := "argocd-github-ssh-secret" }}{{ if .GitSSHSecretName }}{{ $defaultSecret = .GitSSHSecretName }}{{ end }}
{{- if .GitRepositories }}
{{- range $i, $repo := .GitRepositories }}
    "{{ if and $repo.sshPrivateKeySecret $repo.sshPrivateKeySecret.name }}{{ $repo.sshPrivateKeySecret.name }}{{ else }}{{ $defaultSecret }}-{{ $i }}{{ end }}|{{ $repo.url }}|{{ if $repo.type }}{{ $repo.type }}{{ else }}git{{ end }}|{{ if $repo.name }}{{ $repo.name }}{{ end }}|{{ if $repo.sshPrivateKeyFile }}{{ $repo.sshPrivateKeyFile }}{{ end }}"
{{- end }}
{{- else }}
    "{{ $defaultSecret }}|{{ if .GitRepositoryURL }}{{ .GitRepositoryURL }}{{ else }}git@github.com:example-org/gitops.git{{ end }}|git||"
{{- end }}
)

key_for() {
    case "$1" in
        "") printf '%s' "${DEFAULT_KEY_PATH}" ;;
        /*) printf '%s' "$1" ;;
        *) printf '%s/%s' "${KEYS_DIR}" "$1" ;;
    esac
}

# Every key must exist before anything is sealed.
DEFAULT_KEY_USERS=0
for entry in "${REPOSITORIES[@]}"; do
    IFS='|' read -r _ repo_url _ _ key_file <<< "${entry}"
    key_path="$(key_for "${key_file}")"
    if [ -z "${key_file}" ]; then
        DEFAULT_KEY_USERS=$((DEFAULT_KEY_USERS + 1))
    fi
    if [ -z "${key_path}" ]; then
        echo "Usage: $0 <path_to_default_ssh_private_key>"
        echo "Error: ${repo_url} has no sshPrivateKeyFile, so a default key is required."
        exit 1
    fi
    if [ ! -f "${key_path}" ]; then
        echo "Error: SSH private key for ${repo_url} not found: ${key_path}"
        exit 1
    fi
done
if [ "${DEFAULT_KEY_USERS}" -gt 1 ]; then
    echo "Warning: ${DEFAULT_KEY_USERS} repositories share the default key. A GitHub deploy key only reads one"
    echo "         repository: set sshPrivateKeyFile per GitRepositories entry, unless it is a machine user's key."
fi

# Check that kubeseal is installed
if ! command -v kubeseal &> /dev/null; then
    echo "Error: kubeseal is not installed. Please install kubeseal first."
    echo "How to install:"
    echo "  macOS: brew install kubeseal"
    echo "  Linux: download from https://github.com/bitnami-labs/sealed-secrets/releases"
    exit 1
fi

# Check the kubectl connection
if ! kubectl cluster-info &> /dev/null; then
    echo "Error: cannot connect to the Kubernetes cluster. Make sure kubectl is configured correctly."
    exit 1
fi

# Show the current cluster context
CURRENT_CONTEXT=$(kubectl config current-context)
echo "Current Kubernetes context: $CURRENT_CONTEXT"
echo "Warning: make sure you are connected to the right cluster (production)"
echo ""

echo "Generating repository sealed secrets..."

# Do NOT add useSshAgent: it causes "SSH agent requested but SSH_AUTH_SOCK not-specified" in declarative config.
# The output is only written once every kubeseal call has succeeded.
SEALED=""
SEEN_NAMES=" "
for entry in "${REPOSITORIES[@]}"; do
    IFS='|' read -r secret_name repo_url repo_type repo_name key_file <<< "${entry}"
    if [[ "${SEEN_NAMES}" == *" ${secret_name} "* ]]; then
        echo "Error: two repositories use the Secret name ${secret_name}; give each GitRepositories entry its own sshPrivateKeySecret.name."
        exit 1
    fi
    SEEN_NAMES="${SEEN_NAMES}${secret_name} "

    name_args=()
    if [ -n "${repo_name}" ]; then
        name_args=(--from-literal=name="${repo_name}")
    fi
    DOC=$(kubectl create secret generic "${secret_name}" -n "${NAMESPACE}" \
        --from-literal=type="${repo_type}" \
        --from-literal=url="${repo_url}" \
        ${name_args[@]+"${name_args[@]}"} \
        --from-file=sshPrivateKey="$(key_for "${key_file}")" --dry-run=client -o yaml \
        | kubectl label --local -f - argocd.argoproj.io/secret-type=repository -o yaml \
        | kubeseal --format yaml)
    if [ -n "${SEALED}" ]; then
        SEALED="${SEALED}"$'\n---\n'
    fi
    SEALED="${SEALED}${DOC}"
    echo "  ${secret_name}: ${repo_url}"
done

printf '%s\n' "${SEALED}" > "${OUTPUT_FILE}"

echo "Repository sealed secrets generated: ${OUTPUT_FILE}"
echo ""
echo "Next steps:"
echo "1. Add each matching public key (<key>.pub) to its repository as a READ-ONLY deploy key"
echo "   (leave \"Allow write access\" unchecked). Never commit the private key."
echo "2. Deploy the updated ArgoCD configuration"
echo "3. Verify that ArgoCD can access the repository"
