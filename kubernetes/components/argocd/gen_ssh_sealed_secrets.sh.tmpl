#!/bin/bash

set -euo pipefail

# Seals the ArgoCD repository Secrets (repository URL + SSH deploy key).
# Usage: ./gen_ssh_sealed_secrets.sh <path_to_ssh_private_key>
#        REPO_URL=<url> OUTPUT_FILE=<file> ./gen_ssh_sealed_secrets.sh <key>   (one repository only)
#
# ArgoCD 3.x reads repositories only from Secrets labelled argocd.argoproj.io/secret-type=repository
# that hold url, type and sshPrivateKey; the `repositories` key of argocd-cm is no longer read.
# Every configured repository is sealed with the given key. GitHub deploy keys belong to one
# repository: with several repositories either add the key to a machine user, or run the script
# once per key with REPO_URL and OUTPUT_FILE and add the extra files to kustomization.yaml.
# The plaintext Secret is never written to disk: it is piped from kubectl straight into kubeseal.

if [ $# -eq 0 ]; then
    echo "Usage: $0 <path_to_ssh_private_key>"
    echo "Example: $0 ../../../keys/argocd_github"
    exit 1
fi

SSH_KEY_PATH="$1"
NAMESPACE="{{ if .Namespace }}{{ .Namespace }}{{ else }}argocd{{ end }}"
OUTPUT_FILE="${OUTPUT_FILE:-github-ssh-sealed-secret.yaml}"

# <secret name>|<url>|<type>|<display name>
REPOSITORIES=(
{{- $defaultSecret := "argocd-github-ssh-secret" }}{{ if .GitSSHSecretName }}{{ $defaultSecret = .GitSSHSecretName }}{{ end }}
{{- if .GitRepositories }}
{{- range $i, $repo := .GitRepositories }}
    "{{ if and $repo.sshPrivateKeySecret $repo.sshPrivateKeySecret.name }}{{ $repo.sshPrivateKeySecret.name }}{{ else }}{{ $defaultSecret }}-{{ $i }}{{ end }}|{{ $repo.url }}|{{ if $repo.type }}{{ $repo.type }}{{ else }}git{{ end }}|{{ if $repo.name }}{{ $repo.name }}{{ end }}"
{{- end }}
{{- else }}
    "{{ $defaultSecret }}|{{ if .GitRepositoryURL }}{{ .GitRepositoryURL }}{{ else }}git@github.com:example-org/gitops.git{{ end }}|git|"
{{- end }}
)

if [ ! -f "$SSH_KEY_PATH" ]; then
    echo "Error: SSH private key file not found: $SSH_KEY_PATH"
    exit 1
fi

# Check that kubeseal is installed
if ! command -v kubeseal &> /dev/null; then
    echo "Error: kubeseal is not installed. Please install kubeseal first."
    echo "How to install:"
    echo "  macOS: brew install kubeseal"
    echo "  Linux: download from https://github.com/bitnami-labs/sealed-secrets/releases"
    exit 1
fi

# Check the kubectl connection
if ! kubectl cluster-info &> /dev/null; then
    echo "Error: cannot connect to the Kubernetes cluster. Make sure kubectl is configured correctly."
    exit 1
fi

# Show the current cluster context
CURRENT_CONTEXT=$(kubectl config current-context)
echo "Current Kubernetes context: $CURRENT_CONTEXT"
echo "Warning: make sure you are connected to the right cluster (production)"
echo ""

echo "Generating repository sealed secrets..."

# Do NOT add useSshAgent: it causes "SSH agent requested but SSH_AUTH_SOCK not-specified" in declarative config.
# The output is only written once every kubeseal call has succeeded.
SEALED=""
SEEN_NAMES=" "
for entry in "${REPOSITORIES[@]}"; do
    IFS='|' read -r secret_name repo_url repo_type repo_name <<< "${entry}"
    if [ -n "${REPO_URL:-}" ] && [ "${repo_url}" != "${REPO_URL}" ]; then
        continue
    fi
    if [[ "${SEEN_NAMES}" == *" ${secret_name} "* ]]; then
        echo "Error: two repositories use the Secret name ${secret_name}; give each GitRepositories entry its own sshPrivateKeySecret.name."
        exit 1
    fi
    SEEN_NAMES="${SEEN_NAMES}${secret_name} "

    name_args=()
    if [ -n "${repo_name}" ]; then
        name_args=(--from-literal=name="${repo_name}")
    fi
    DOC=$(kubectl create secret generic "${secret_name}" -n "${NAMESPACE}" \
        --from-literal=type="${repo_type}" \
        --from-literal=url="${repo_url}" \
        ${name_args[@]+"${name_args[@]}"} \
        --from-file=sshPrivateKey="${SSH_KEY_PATH}" --dry-run=client -o yaml \
        | kubectl label --local -f - argocd.argoproj.io/secret-type=repository -o yaml \
        | kubeseal --format yaml)
    if [ -n "${SEALED}" ]; then
        SEALED="${SEALED}"$'\n---\n'
    fi
    SEALED="${SEALED}${DOC}"
    echo "  ${secret_name}: ${repo_url}"
done

if [ -z "${SEALED}" ]; then
    echo "Error: no configured repository matches REPO_URL=${REPO_URL:-}"
    exit 1
fi
printf '%s\n' "${SEALED}" > "${OUTPUT_FILE}"

echo "Repository sealed secrets generated: ${OUTPUT_FILE}"
echo ""
echo "Next steps:"
echo "1. Add the matching public key (${SSH_KEY_PATH}.pub) to the GitOps repository as a READ-ONLY deploy key"
echo "   (leave \"Allow write access\" unchecked). Never commit the private key."
echo "2. Deploy the updated ArgoCD configuration"
echo "3. Verify that ArgoCD can access the repository"
