#!/bin/bash

set -euo pipefail

# Seals the GitHub OAuth client secret that Dex uses for ArgoCD SSO.
# Usage: DEX_GITHUB_CLIENT_SECRET=<secret> ./gen_dex_sealed_secret.sh
#        ./gen_dex_sealed_secret.sh            (prompts for the secret)
#
# argocd-cm references the value as $<secret name>:<key>, so it never appears in the
# ConfigMap or in git. ArgoCD only resolves such references from Secrets labelled
# app.kubernetes.io/part-of=argocd. Instead of this script you can create the same
# Secret with an ExternalSecret (set that label under spec.target.template.metadata.labels).
# The plaintext Secret is never written to disk: it is piped from kubectl straight into kubeseal.

NAMESPACE="{{ if .Namespace }}{{ .Namespace }}{{ else }}argocd{{ end }}"
SECRET_NAME="{{ if .DexClientSecretName }}{{ .DexClientSecretName }}{{ else }}argocd-dex-github{{ end }}"
SECRET_KEY="{{ if .DexClientSecretKey }}{{ .DexClientSecretKey }}{{ else }}clientSecret{{ end }}"
OUTPUT_FILE="dex-github-sealed-secret.yaml"

if ! command -v kubeseal &> /dev/null; then
    echo "Error: kubeseal is not installed. Please install kubeseal first."
    exit 1
fi

if ! kubectl cluster-info &> /dev/null; then
    echo "Error: cannot connect to the Kubernetes cluster. Make sure kubectl is configured correctly."
    exit 1
fi

echo "Current Kubernetes context: $(kubectl config current-context)"

if [ -z "${DEX_GITHUB_CLIENT_SECRET:-}" ]; then
    if [ -t 0 ]; then
        read -r -s -p "GitHub OAuth client secret for Dex: " DEX_GITHUB_CLIENT_SECRET
        echo
    else
        echo "Error: set DEX_GITHUB_CLIENT_SECRET or run this script in a terminal."
        exit 1
    fi
fi
if [ -z "${DEX_GITHUB_CLIENT_SECRET}" ]; then
    echo "Error: empty client secret."
    exit 1
fi

# The output is only written once kubeseal has succeeded.
SEALED=$(printf '%s' "${DEX_GITHUB_CLIENT_SECRET}" \
    | kubectl create secret generic "${SECRET_NAME}" -n "${NAMESPACE}" \
        --from-file="${SECRET_KEY}=/dev/stdin" --dry-run=client -o yaml \
    | kubectl label --local -f - app.kubernetes.io/part-of=argocd -o yaml \
    | kubeseal --format yaml)
printf '%s\n' "${SEALED}" > "${OUTPUT_FILE}"

echo "Dex client secret sealed: ${OUTPUT_FILE} (Secret ${NAMESPACE}/${SECRET_NAME}, key ${SECRET_KEY})"
