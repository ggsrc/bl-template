apiVersion: kustomize.config.k8s.io/v1beta1
kind: Kustomization

# The upstream install.yaml has no namespaces; without this every ArgoCD workload lands in the
# kubectl default namespace while the install script and the Applications expect argocd.
# unsetOnly: a plain `namespace:` would also rename the Namespace objects (argocd, app).
transformers:
- |-
  apiVersion: builtin
  kind: NamespaceTransformer
  metadata:
    name: argocd-namespace
    namespace: {{ if .Namespace }}{{ .Namespace }}{{ else }}argocd{{ end }}
  unsetOnly: true

resources:
- namespace.yaml
- app-namespace.yaml
{{- if eq (printf "%v" .GitAuthMethod) "ssh" }}
- github-ssh-sealed-secret.yaml
{{- else }}
- github-app-sealed-secret.yaml
{{- end }}
{{- if or .DexConfig .DexGitHubEnabled }}
- dex-github-sealed-secret.yaml
{{- end }}
# ArgoCD {{ if .ArgoCDVersion }}{{ .ArgoCDVersion }}{{ else }}v3.5.6{{ end }} manifests/install.yaml, downloaded by the install script and kept only if its
# sha256 matches the pin, so kustomize never fetches an unverified remote manifest. Commit it:
# kubectl delete -k (blcli destroy) and kustomize build need it.
- argocd-install.yaml

patchesStrategicMerge:
  # RBAC: roles for the GitHub org groups, no access for anyone else
  - argocd-rbac-cm.yaml

  # Configure argocd server
  - argocd-cmd-params-cm.yaml

patches:
- path: argocd-cm.yaml
