apiVersion: kustomize.config.k8s.io/v1beta1
kind: Kustomization

resources:
- namespace.yaml
- app-namespace.yaml
- github-ssh-sealed-secret.yaml
{{- if or .DexConfig .DexGitHubEnabled }}
- dex-github-sealed-secret.yaml
{{- end }}
# ArgoCD {{ if .ArgoCDVersion }}{{ .ArgoCDVersion }}{{ else }}v3.5.6{{ end }} manifests/install.yaml. The install script downloads it, checks its sha256 and
# deletes it after the build, so kustomize never fetches an unverified remote manifest.
- argocd-install.yaml

patchesStrategicMerge:
  # RBAC: roles for the GitHub org groups, no access for anyone else
  - argocd-rbac-cm.yaml

  # Configure argocd server
  - argocd-cmd-params-cm.yaml

patches:
- path: argocd-cm.yaml
