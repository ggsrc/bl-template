version: 1.0.0

# Global parameter definitions for the terraform directory
# These parameters apply to every component under the terraform directory (unless overridden by component-level parameters)

parameters:
  # Global parameters
  global:
    OrganizationID:
      type: string
      description: "GCP Organization ID. Set to \"0\" to disable org_id rendering in templates."
      required: false
      default: "0"
      example: "123456789012"
      pattern: "^[0-9]+$"
    
    BillingAccountID:
      type: string
      description: "GCP Billing Account ID"
      required: true
      example: "01ABCD-2EFGH3-4IJKL5"
      pattern: "^[0-9A-Z-]+$"
    
    ProjectName:
      type: string
      description: "Project name used for resource naming"
      required: false
      example: "my-project"
      pattern: "^[a-z0-9-]+$"

